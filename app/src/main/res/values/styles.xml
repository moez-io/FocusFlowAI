<?xml version="1.0" encoding="utf-8"?>
<resources>
 <style name="Theme.FocusFlow" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:fontFamily">sans</item>
  <item name="android:colorAccent">#6958E8</item>
  <item name="android:statusBarColor">#F5F7FC</item>
  <item name="android:navigationBarColor">#FFFFFF</item>
  <item name="android:windowLightStatusBar">true</item>
  <item name="android:windowLightNavigationBar">true</item>
  <item name="android:windowBackground">#F5F7FC</item>
  <item name="android:windowActionModeOverlay">true</item>
 </style>
 <style name="Theme.FocusFlow.Splash" parent="Theme.FocusFlow">
  <item name="android:windowBackground">#0B1630</item>
  <item name="android:statusBarColor">#0B1630</item>
  <item name="android:windowLightStatusBar">false</item>
  <item name="android:navigationBarColor">#0B1630</item>
  <item name="android:windowLightNavigationBar">false</item>
 </style>
</resources>
